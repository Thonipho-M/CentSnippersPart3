<?xml version="1.0" encoding="utf-8"?>
<!--
    item_video.xml
    - Displays a single video resource with a thumbnail and title
    - Clean, modern design for consistency across the app
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:elevation="6dp"
    android:background="@android:color/white"
    android:foreground="?android:attr/selectableItemBackground"
    android:padding="8dp"
    android:radius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Video thumbnail loaded from YouTube URL -->
        <ImageView
            android:id="@+id/videoThumbnail"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:contentDescription="Video Thumbnail"
            android:background="@android:color/darker_gray" />

        <!-- Video title shown below the thumbnail -->
        <TextView
            android:id="@+id/videoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Video Title"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
