<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/offWhite">

<!-- ===================================================
     fragment_income.xml
     =================================================== -->
<LinearLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header / Total Display -->
    <TextView
        android:id="@+id/incomeHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Income Sources"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/totalIncomeThisMonth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total Income: R0.00"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"/>

    <!-- RecyclerView to list all income records -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/incomeRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <!-- Add Income Floating Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addIncomeFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Add Income"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="@android:color/white"
        android:backgroundTint="@color/leatherBrown" />
</LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
