<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/pieChartContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- CARD: Total Spent -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Spent by Category"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:paddingBottom="8dp"/>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartActualSpend"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/legendActualSpend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD: Goal Amount -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Goal Amounts"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:paddingBottom="8dp"/>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartGoalAmount"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/legendGoalAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Legend goes here..." />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD: Min Spend -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="16dp">
            <!-- Message shown when no data is available for charts -->
            <TextView
                android:id="@+id/MINemptyChartMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No chart data available. This could be because one or more categories are missing spending limits or transactions for the selected period."
                android:textAlignment="center"
                android:textColor="@android:color/darker_gray"
                android:textSize="16sp"
                android:padding="24dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minimum Spend Targets"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:paddingBottom="8dp"/>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartMinSpend"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/legendMinSpend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Legend goes here..." />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD: Max Spend -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <!-- Message shown when no data is available for charts -->
                <TextView
                    android:id="@+id/MAXemptyChartMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No chart data available. This could be because one or more categories are missing spending limits or transactions for the selected period."
                    android:textAlignment="center"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="16sp"
                    android:padding="24dp"
                    android:visibility="gone" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maximum Spend Limits"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:paddingBottom="8dp"/>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartMaxSpend"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/legendMaxSpend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Legend goes here..." />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
