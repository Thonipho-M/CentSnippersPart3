<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboardScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#A5B2A1"> <!-- Muted green background -->

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F8F5F0"
        android:padding="16dp"
        android:layout_margin="8dp"
        android:elevation="4dp"
        android:clipToPadding="false"
        android:backgroundTintMode="src_in">

    <TextView
        android:id="@+id/totalIncomeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Income: R0"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#2E2E2E"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/totalExpensesText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Expenses: R0"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#2E2E2E"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/remainingBudgetText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Remaining Budget: R0"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#2E2E2E"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/overspendingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Overspending: None"
        android:textSize="18sp"
        android:textStyle="italic"
        android:textColor="#C62828"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp" />

</LinearLayout>
    </ScrollView>
